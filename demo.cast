[0.380, "o", "\r\n\u001b[1m\u001b[94m────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[1m\u001b[94m  STEP 1 — Agent Key Generation\u001b[0m\r\n\u001b[1m\u001b[94m────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n"]
[0.001, "o", "  \u001b[92m✔\u001b[0m  finance-agent  pub=fd4398bd7b0bc172d67cb9c9…\r\n  \u001b[92m✔\u001b[0m  startup-agent  pub=196ea7d978466b980de94e8a…\r\n     \u001b[2mEd25519 key pairs — envelopes are cryptographically bound to agent identity\u001b[0m\r\n"]
[1.500, "o", "\r\n\u001b[1m\u001b[94m────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[1m\u001b[94m  STEP 2 — Policy Compilation (PolicyDecisionPoint)\u001b[0m\r\n\u001b[1m\u001b[94m────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n"]
[0.001, "o", "  \u001b[92m✔\u001b[0m  Intent:         \"read Q1 budget summary for cost analysis\"\r\n  \u001b[92m✔\u001b[0m  Scopes granted: ['vault:finance:read']\r\n"]
[0.000, "o", "  \u001b[92m✔\u001b[0m  Scopes denied:  ['vault:finance:write', 'vault:startup:read', 'audit:read']\r\n"]
[0.000, "o", "  \u001b[92m✔\u001b[0m  Rules fired:    ['slos-finance-read']\r\n     \u001b[2mDeterministic: same intent → same scopes, every time. No LLM in the loop.\u001b[0m\r\n"]
[1.505, "o", "\r\n\u001b[1m\u001b[94m────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[1m\u001b[94m  STEP 3 — Signed AuthorityEnvelope\u001b[0m\r\n\u001b[1m\u001b[94m────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n"]
[0.002, "o", "  \u001b[92m✔\u001b[0m  Envelope ID:  env-fef4a6277af8\r\n  \u001b[92m✔\u001b[0m  Agent:        finance-agent\r\n  \u001b[92m✔\u001b[0m  Scopes:       ['vault:finance:read']\r\n  \u001b[92m✔\u001b[0m  Signature:    a30c0376d56b0a77de4c88b461ae4e82d9af9f7f…\r\n"]
[0.000, "o", "  \u001b[92m✔\u001b[0m  Expires:      2026-03-07T19:15:36.259336Z\r\n"]
[0.000, "o", "     \u001b[2mTampering with scopes or agent_id invalidates the Ed25519 signature.\u001b[0m\r\n"]
[1.505, "o", "\r\n\u001b[1m\u001b[94m────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[1m\u001b[94m  STEP 4 — Access Enforcement (MemoryBackend)\u001b[0m\r\n\u001b[1m\u001b[94m────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n  \u001b[92m✔\u001b[0m  finance-agent  → \u001b[92mALLOW\u001b[0m  slos://vaults/finance/q1-budget-2026\r\n     \u001b[2mreason: Agent 'finance-agent' explicitly allowed by document\u001b[0m\r\n"]
[0.002, "o", "  \u001b[91m✘\u001b[0m  startup-agent  → \u001b[91mDENY\u001b[0m   slos://vaults/finance/q1-budget-2026\r\n     \u001b[2mreason: Agent 'startup-agent' explicitly denied by document\u001b[0m\r\n"]
[1.505, "o", "\r\n\u001b[1m\u001b[94m────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[1m\u001b[94m  STEP 5 — Document Read\u001b[0m\r\n\u001b[1m\u001b[94m────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n"]
